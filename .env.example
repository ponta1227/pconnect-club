# ===== 必須 =====
# Supabase の接続文字列（「Connect」→「Transaction pooler」の URI。パスワードを入れる）
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# 公開URL（末尾スラッシュなし）
APP_URL=https://club.pconnect.jp
# LINE Developers の LINEログインチャネル
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 最初の管理者を作るときだけ使う合言葉（/setup?secret=この値）。十分に長いランダムな文字列にする
SETUP_SECRET=
# 定期処理（/api/cron/daily）の認証用。Vercel に設定すると Cron が自動で付けて呼ぶ
CRON_SECRET=

# ===== ファイル保存（Supabase Storage） =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role キー（サーバー側だけで使う。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=club-files

# ===== Webプッシュ通知（npx web-push generate-vapid-keys で作成） =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@pconnect.jp

# ===== メール通知（Resend） =====
RESEND_API_KEY=
MAIL_FROM=P-CONNECT Jr. <noreply@club.pconnect.jp>

# ===== 開発用（本番では設定しない） =====
# ALLOW_DEV_LOGIN=1
